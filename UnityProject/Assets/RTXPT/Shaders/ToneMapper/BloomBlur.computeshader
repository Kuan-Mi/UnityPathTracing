/*
* Separable Gaussian blur for bloom — compute port of donut passes/bloom_ps.hlsl (verbatim weights).
* Run twice (horizontal then vertical) by swapping pixstep. Operates at quarter resolution.
*/

#pragma pack_matrix(row_major)

// Mirrors donut/shaders/bloom_cb.h BloomConstants (32 bytes).
struct BloomConstants
{
    float2 pixstep;
    float  argumentScale;
    float  normalizationScale;
    float3 padding;
    float  numSamples;
};

cbuffer c_Bloom : register(b0)
{
    BloomConstants g_Bloom;
};

Texture2D<float4>   t_Src                : register(t0);
SamplerState        s_LinearClampSampler : register(s0);
RWTexture2D<float4> u_Dst                : register(u0);

float square(float x) { return x * x; }

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint w, h;
    u_Dst.GetDimensions(w, h);
    if (tid.x >= w || tid.y >= h)
        return;

    float2 uv     = (float2(tid.xy) + 0.5) / float2(w, h);
    float3 result = t_Src[tid.xy].rgb;

    for (float x = 1; x < g_Bloom.numSamples; x += 2)
    {
        float w1 = exp(square(x)     * g_Bloom.argumentScale);
        float w2 = exp(square(x + 1) * g_Bloom.argumentScale);

        float  w12    = w1 + w2;
        float  p      = w2 / w12;
        float2 offset = g_Bloom.pixstep * (x + p);

        result += t_Src.SampleLevel(s_LinearClampSampler, uv + offset, 0).rgb * w12;
        result += t_Src.SampleLevel(s_LinearClampSampler, uv - offset, 0).rgb * w12;
    }

    result *= g_Bloom.normalizationScale;
    u_Dst[tid.xy] = float4(result, 1.0);
}
