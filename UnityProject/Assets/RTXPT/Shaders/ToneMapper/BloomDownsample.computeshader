/*
* Bilinear 2x downsample for the bloom chain (compute port of donut CommonRenderPasses::BlitTexture
* downscale used by BloomPass). One bilinear tap per destination texel averages the 2x2 source block.
*/

#pragma pack_matrix(row_major)

Texture2D<float4>   t_Src                 : register(t0);
SamplerState        s_LinearClampSampler  : register(s0);
RWTexture2D<float4> u_Dst                 : register(u0);

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint w, h;
    u_Dst.GetDimensions(w, h);
    if (tid.x >= w || tid.y >= h)
        return;

    float2 uv = (float2(tid.xy) + 0.5) / float2(w, h);
    u_Dst[tid.xy] = float4(t_Src.SampleLevel(s_LinearClampSampler, uv, 0).rgb, 1.0);
}
