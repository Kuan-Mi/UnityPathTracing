/*
* Fully-native average-luminance reduction for RTXPT auto-exposure.
*
* Replaces the original luminance_ps + GenerateMips + capture_cs chain: that path used
* Unity's GenerateMips (a sampler-heap op) interleaved with native plugin dispatches, which
* left a SAMPLER descriptor heap bound and tripped D3D12 root-descriptor validation. This is a
* single thread group that strides over the whole image, computing the average of log2(luminance)
* (i.e. log of the geometric-mean luminance) into a one-float buffer. The apply shader exp2's it.
*/

#pragma pack_matrix(row_major)

Texture2D<float4> gColorTex      : register(t0);
RWBuffer<float>   u_AvgLuminance : register(u0); // [0] = average log2 luminance

#define NT 256
groupshared float gsSum[NT];
groupshared float gsCnt[NT];

float calcLuminance(float3 color)
{
    return dot(color, float3(0.299, 0.587, 0.114));
}

[numthreads(NT, 1, 1)]
void main(uint gi : SV_GroupIndex)
{
    uint w, h;
    gColorTex.GetDimensions(w, h);
    uint total = w * h;

    float sum = 0.0;
    float cnt = 0.0;
    for (uint i = gi; i < total; i += NT)
    {
        uint2 px = uint2(i % w, i / w);
        sum += log2(max(0.0001, calcLuminance(gColorTex[px].rgb)));
        cnt += 1.0;
    }

    gsSum[gi] = sum;
    gsCnt[gi] = cnt;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint s = NT / 2; s > 0; s >>= 1)
    {
        if (gi < s)
        {
            gsSum[gi] += gsSum[gi + s];
            gsCnt[gi] += gsCnt[gi + s];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (gi == 0)
        u_AvgLuminance[0] = (gsCnt[0] > 0.0) ? (gsSum[0] / gsCnt[0]) : 0.0;
}
