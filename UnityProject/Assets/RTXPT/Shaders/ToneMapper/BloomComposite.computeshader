/*
* Composites the blurred bloom back into the HDR image, in place. Matches donut BloomPass's final
* blit blend (SrcBlend=ConstantColor, DestBlend=InvConstantColor): result = lerp(original, bloom, intensity).
* The bloom texture is quarter-resolution and is bilinearly upsampled here.
*/

#pragma pack_matrix(row_major)

cbuffer c_Composite : register(b0)
{
    float  g_blendFactor;
    float3 _padding;
};

Texture2D<float4>   t_Bloom              : register(t0);
SamplerState        s_LinearClampSampler : register(s0);
RWTexture2D<float4> u_Output             : register(u0); // HDR image, read-modify-write

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint w, h;
    u_Output.GetDimensions(w, h);
    if (tid.x >= w || tid.y >= h)
        return;

    float2 uv       = (float2(tid.xy) + 0.5) / float2(w, h);
    float4 original = u_Output[tid.xy];
    float3 bloom    = t_Bloom.SampleLevel(s_LinearClampSampler, uv, 0).rgb;

    float3 result = lerp(original.rgb, bloom, g_blendFactor);
    u_Output[tid.xy] = float4(result, original.a);
}
